# Frontend (Astro). Copiá este archivo a .env y completá los valores que uses.

# URL del backend de mensajería (default: http://localhost:8787).
PUBLIC_API_BASE=http://localhost:8787

# Asistente de IA (opcional).
# Endpoint HTTP que recibe { prompt: string } y responde { text: string }.
# Sin esto, el reporte del dashboard y el copilot quedan desactivados.
PUBLIC_AI_ENDPOINT=
