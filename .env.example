# Firebase (Firestore) — opcional.
# Sin estas variables la app corre en modo demo local: los datos se guardan en
# el localStorage del navegador y cambia sola a Firestore cuando las completes.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Asistente de IA (opcional, a configurar más adelante).
# Endpoint HTTP que recibe { prompt: string } y responde { text: string }.
# Ejemplo para Gemini via proxy: https://tu-api.example.com/ai
PUBLIC_AI_ENDPOINT=
